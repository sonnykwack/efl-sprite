# Normalise line endings: LF in the repo and in every working copy (macOS + Windows).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries — never touch.
*.png  binary
*.ico  binary
*.icns binary
*.wav  binary
*.gguf binary
*.bin  binary
*.zip  binary
